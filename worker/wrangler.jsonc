{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barcode-wms",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/*.html"]
  },
  "rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": true }],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
